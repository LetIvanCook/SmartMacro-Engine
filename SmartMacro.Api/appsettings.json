{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=SmartMacroDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_32_BYTES_LONG",
    "Issuer": "SmartMacroApi",
    "Audience": "SmartMacroClient",
    "ExpireMinutes": 15,
    "RefreshTokenExpireDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.smartmacro.example.com",
      "https://staging.smartmacro.example.com"
    ]
  },
  "Anthropic": {
    "ApiKey": "",
    "BaseUrl": "https://api.anthropic.com/",
    "Model": "claude-sonnet-5-5",
    "MaxTokens": 4096,
    "TimeoutSeconds": 90
  },
  "Research": {
    "Enabled": false,
    "AllowedHosts": [
      "macrofactor.com",
      "cronometer.com",
      "myfitnesspal.com",
      "eatthismuch.com"
    ],
    "MaxContentChars": 30000,
    "NavigationTimeoutSeconds": 30,
    "MaxConcurrentBrowsers": 2,
    "CacheHours": 24,
    "AutoResearchEnabled": false,
    "IntervalMinutes": 1440,
    "InitialDelaySeconds": 30,
    "ScheduledTargets": [
      {
        "TargetUrl": "https://cronometer.com/",
        "FocusTopic": "dynamic energy expenditure and micronutrient target tracking"
      },
      {
        "TargetUrl": "https://macrofactor.com/",
        "FocusTopic": "smart macro planning and dynamic metabolic adaptation"
      }
    ]
  },
  "AllowedHosts": "*"
}
