# ── SmartMacro Engine Docker Environment Template ──────────────
# Copy file này thành .env và thay đổi các giá trị bảo mật
# KHÔNG COMMIT FILE .env THẬT LÊN GIT!

SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
ASPNETCORE_ENVIRONMENT=Production
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
